# Optional. Deterministic exercises and saved progress work without these.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# To retain direct OpenAI access, set AI_PROVIDER=openai instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set true when deploying behind HTTPS; leave false for http://localhost.
SECURE_COOKIES=false
# Optional absolute directory for SQLite and private recordings.
# DATA_DIR=D:/IELTS Practice/ielts-sprint-30/data
# Required on Vercel: connect Turso through the Vercel Marketplace.
# These are server-only secrets. Never prefix them with NEXT_PUBLIC_.
# Leave unset to keep using local SQLite on a persistent computer/server.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-database-token
# Optional server-side overrides for the personal login (defaults: TTH / 9834).
# LOGIN_USERNAME=TTH
# LOGIN_PASSWORD=9834
